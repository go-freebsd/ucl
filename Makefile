GO       ?= go
GOYACC   ?= $(GO) run golang.org/x/tools/cmd/goyacc@v0.52.0
FUZZTIME ?= 60s
COVER    ?= coverage.out
PKG      ?= ./pkg/ucl

.PHONY: all build test vet fmt lint generate examples fuzz cover cover-html clean

all: lint test

build:
	$(GO) build ./...

test:
	$(GO) test ./...

vet:
	$(GO) vet ./...

fmt:
	$(GO) fmt ./...

lint: vet
	@out=$$(gofmt -l .); if [ -n "$$out" ]; then echo "gofmt needed:"; echo "$$out"; exit 1; fi

# Regenerate the parser from ucl.y. The result is checked in so that building
# the package never needs goyacc.
generate:
	cd pkg/ucl && $(GOYACC) -o ucl.y.go -p yy ucl.y
	@rm -f pkg/ucl/y.output
	gofmt -w pkg/ucl/ucl.y.go

# Run the documentation examples on their own and show what each prints.
examples:
	$(GO) test -run Example -v $(PKG)

fuzz:
	$(GO) test -run Fuzz -fuzz FuzzParse -fuzztime $(FUZZTIME) $(PKG)

# Coverage. Two figures are printed on purpose.
#
# ucl.y.go is generated by goyacc and carries a "//line yaccpar:1" directive,
# so its statements land in the profile under the synthetic name "yaccpar" and
# several distinct blocks collapse onto the same coordinates. That makes
# "go tool cover" fail outright with "inconsistent NumStmt", which is why the
# profile is filtered before it is summarised rather than afterwards.
#
# The directive also hides the semantic actions written in ucl.y, so the raw
# figure is kept alongside as the only one that still accounts for them.
cover:
	@$(GO) test -covermode=set -coverprofile=$(COVER) $(PKG)
	@grep -v yaccpar $(COVER) > $(COVER).hand
	@echo
	@printf 'including the generated parser: '
	@awk 'NR>1 {t+=$$2; if($$3>0) c+=$$2} END {printf "%.1f%% (%d/%d statements)\n", 100*c/t, c, t}' $(COVER)
	@printf 'hand written code:              '
	@awk 'NR>1 {t+=$$2; if($$3>0) c+=$$2} END {printf "%.1f%% (%d/%d statements)\n", 100*c/t, c, t}' $(COVER).hand
	@echo
	@echo 'functions below 70%:'
	@$(GO) tool cover -func=$(COVER).hand | awk '$$NF ~ /%$$/ && $$NF+0 < 70'

# The same profile as a browsable report.
cover-html: cover
	$(GO) tool cover -html=$(COVER).hand -o coverage.html
	@echo 'wrote coverage.html'

clean:
	rm -f pkg/ucl/y.output $(COVER) $(COVER).hand coverage.html
